# ------------------------------------------------------------
# SAFEPATH environment example. Copy to .env and adjust.
# ------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Public URL of the app (used for live-share and password-reset links)
APP_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string
COOKIE_SECURE=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=safepath

# First administrator account created by `npm run db:seed`
ADMIN_NAME=SAFEPATH Administrator
ADMIN_EMAIL=admin@safepath.app
ADMIN_PASSWORD=Admin@12345

# Email alerts for SOS + password resets (optional).
# Without SMTP the app tells users alerts could NOT be delivered — it never fakes delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SAFEPATH Alerts <no-reply@safepath.app>

# Optional generic webhook (Slack / Discord / Telegram bridge) for SOS alerts
SOS_WEBHOOK_URL=

# Show password-reset links on screen when email is not configured (dev only)
EXPOSE_RESET_TOKEN=true

# OpenStreetMap services (no API key required)
OSRM_URL=https://router.project-osrm.org
VALHALLA_URL=https://valhalla1.openstreetmap.de
OVERPASS_URL=https://overpass.osm.ch/api/interpreter,https://overpass-api.de/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter
