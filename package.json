{
  "name": "safepath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAFEPATH - Women Safe Route Navigator (React + Express + MySQL)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "db:setup": "node scripts/db-setup.js",
    "db:seed": "node scripts/seed.js",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  }
}
